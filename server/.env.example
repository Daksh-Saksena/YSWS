# Trek Backend — Environment Variables
# Copy this to .env and fill in real values before running.

# ─────────────────────────────────────────────────
# DATABASE (PostgreSQL — Railway provides this)
# ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/trek_db

# ─────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# The public URL of THIS backend (used for Slack OAuth redirect)
# e.g. https://trek-backend.up.railway.app
SERVER_URL=http://localhost:3001

# The public URL of your FRONTEND
FRONTEND_URL=http://localhost:8000

# ─────────────────────────────────────────────────
# JWT (generate a long random secret: openssl rand -hex 64)
# ─────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_very_long_random_string_at_least_64_chars

# ─────────────────────────────────────────────────
# HACK CLUB SLACK OAUTH
# 1. Go to https://api.slack.com/apps and click "Create New App"
# 2. Choose "From scratch", name it "Trek", pick the Hack Club workspace
# 3. Go to "OAuth & Permissions"
# 4. Add redirect URL: http://localhost:3001/auth/callback (and your Railway URL)
# 5. Add User Token Scopes: identity.basic, identity.avatar, identity.email
# 6. Go to "Basic Information" to copy Client ID and Secret
# ─────────────────────────────────────────────────
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here

# ─────────────────────────────────────────────────
# CLOUDINARY (free at cloudinary.com)
# 1. Sign up at https://cloudinary.com
# 2. Go to your Dashboard to find these values
# ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─────────────────────────────────────────────────
# BACKUPS (optional local path for pg_dump files)
# ─────────────────────────────────────────────────
BACKUP_DIR=./backups
